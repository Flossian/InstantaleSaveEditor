<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- ゲーム互換 JSON エンコーダ(GameJsonEncoder)が char* オーバーライドを使うため必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>InstantaleSaveEditor</AssemblyName>
    <Version>10.0.0</Version>

    <!-- 単体 exe（.NET ランタイム同梱）配布の既定設定 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- InstantaleWorldGen は参考用の別ソース一式(独自 Program.cs 等)のためビルド対象から除外する -->
  <ItemGroup>
    <Compile Remove="InstantaleWorldGen\**\*.cs" />
    <Compile Remove="InstantaleWorldGen\**\*.xaml.cs" />
    <EmbeddedResource Remove="InstantaleWorldGen\**\*" />
    <None Remove="InstantaleWorldGen\**\*" />
    <Content Remove="InstantaleWorldGen\**\*" />
  </ItemGroup>

  <!-- 多言語の埋め込み基底。外部 lang\ が無くても日英が動く。論理名を lang.<code>.json に固定する。 -->
  <ItemGroup>
    <EmbeddedResource Include="lang\ja.json" LogicalName="lang.ja.json" />
    <EmbeddedResource Include="lang\en.json" LogicalName="lang.en.json" />
    <EmbeddedResource Include="lang\zh.json" LogicalName="lang.zh.json" />
  </ItemGroup>

  <!-- 列挙的フィールド(category/job 等)の候補テンプレート。外部 field_options.json が無くても動く基底。 -->
  <ItemGroup>
    <EmbeddedResource Include="setting\field_options.json" LogicalName="field_options.json" />
  </ItemGroup>

  <!-- ワールド生成の名前プール基底。外部 namelist\ が無くても動く（あれば外部を優先）。 -->
  <ItemGroup>
    <EmbeddedResource Include="namelist\*.json" LogicalName="namelist.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
