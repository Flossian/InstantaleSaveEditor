<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>InstantaleSaveEditor</AssemblyName>
    <Version>3.0.0</Version>

    <!-- 単体 exe（.NET ランタイム同梱）配布の既定設定 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- 多言語の埋め込み基底。外部 lang\ が無くても日英が動く。論理名を lang.<code>.json に固定する。 -->
  <ItemGroup>
    <EmbeddedResource Include="lang\ja.json" LogicalName="lang.ja.json" />
    <EmbeddedResource Include="lang\en.json" LogicalName="lang.en.json" />
    <EmbeddedResource Include="lang\zh.json" LogicalName="lang.zh.json" />
  </ItemGroup>

</Project>
